# ── Required ────────────────────────────────────────────────────────────────
# Development: SQLite file. Production: a PostgreSQL URL, e.g.
# postgresql://USER:PASSWORD@HOST:5432/british_bangla_news?schema=public
DATABASE_URL="file:./dev.db"

# Public address of the site, no trailing slash. Used for canonical URLs, sitemaps,
# Open Graph and structured data. Must be the real https:// domain in production.
SITE_URL="http://localhost:3000"

# Where uploaded images and videos are stored. Must be persistent storage that is
# backed up (see README → Backups).
UPLOAD_DIR="./storage/uploads"

# ── First administrator (used by `npm run db:seed` / `npm run create-admin`) ──
# Set these when seeding, then remove them from the environment.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""   # at least 12 characters
ADMIN_NAME=""

# ── Optional ────────────────────────────────────────────────────────────────
# Seed demo articles/videos (all labelled "নমুনা"). Set to "false" for production.
SEED_SAMPLE_CONTENT="true"

# Timezone used for displayed dates, scheduling and date archives.
NEWSROOM_TIMEZONE="Asia/Dhaka"

# Maximum size of an uploaded video file, in MB.
VIDEO_MAX_MB="200"

# Set to "false" only when testing a production build over plain http on localhost.
# COOKIE_SECURE="false"
